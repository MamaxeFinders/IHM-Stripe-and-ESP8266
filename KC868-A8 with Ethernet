#include <Arduino.h>
#include <esp_arduino_version.h>

// ===== Ethernet PHY config =====
#define ETH_PHY_TYPE   ETH_PHY_LAN8720
#define ETH_PHY_ADDR   0
#define ETH_PHY_MDC    23
#define ETH_PHY_MDIO   18
#define ETH_PHY_POWER  -1
#define ETH_CLK_MODE   ETH_CLOCK_GPIO17_OUT

#include <WiFi.h>
#include <ETH.h>
#include <WebServer.h>
#include <ArduinoJson.h>
#include <PCF8574.h>

#define ARDUINOJSON_DEFAULT_NESTING_LIMIT 20

// ===== KC868-A8v2 I2C / Relay board =====
PCF8574 relayBoard(0x24, 4, 5);

WebServer server(80);
StaticJsonDocument<2500> jsonDocument;

// ===== Relay mapping =====
// If relay 4 channel is defective on your board, change RELAY4 to P4
#define RELAY1 P0
#define RELAY2 P1
#define RELAY3 P2
#define RELAY4 P3

volatile bool eth_connected = false;

// One request = one pulse job
int pendingPiste = 0;
int pendingSessions = 0;
bool pulsePending = false;

// Coin pulse timing
const uint16_t RELAY_PRE_PULSE_MS = 20;
const uint16_t RELAY_PULSE_ON_MS = 140;
const uint16_t RELAY_POST_PULSE_MS = 80;
const uint16_t RELAY_INTER_PULSE_GAP_MS = 180;

// ===== Recovery / monitoring =====
unsigned long bootMillis = 0;
unsigned long ethDownSinceMillis = 0;
unsigned long lastRequestMillis = 0;
unsigned long lastHealthLogMillis = 0;
unsigned long lastEthWatchdogMillis = 0;

// Boot / watchdog timings
const unsigned long BOOT_ETH_WAIT_MS         = 30000UL;    // wait max 30s at boot
const unsigned long ETH_WATCHDOG_MS          = 5000UL;     // verify ETH every 5s
const unsigned long ETH_NO_IP_RESTART_MS     = 20000UL;    // link up but no IP too long
const unsigned long ETH_LINK_DOWN_RESTART_MS = 120000UL;   // restart if link down > 2 min
const unsigned long HEALTH_LOG_MS            = 300000UL;   // serial health log every 5 min

// Optional preventive reboot once per day
const bool ENABLE_DAILY_REBOOT = false;
const unsigned long DAILY_REBOOT_MS = 24UL * 60UL * 60UL * 1000UL;

// Keep false if you use Livebox "Baux DHCP statiques"
const bool USE_STATIC_ETH_IP = false;
IPAddress ETH_LOCAL_IP(192, 168, 1, 16);
IPAddress ETH_GATEWAY(192, 168, 1, 1);
IPAddress ETH_SUBNET(255, 255, 255, 0);
IPAddress ETH_DNS1(1, 1, 1, 1);
IPAddress ETH_DNS2(8, 8, 8, 8);

// =====================================================
// Relay logic
// KinCony relays are active LOW:
// LOW  = ON
// HIGH = OFF
// =====================================================
void relayOn(uint8_t pin) {
  relayBoard.digitalWrite(pin, LOW);
}

void relayOff(uint8_t pin) {
  relayBoard.digitalWrite(pin, HIGH);
}

void allRelaysOff() {
  relayBoard.digitalWrite(P0, HIGH);
  relayBoard.digitalWrite(P1, HIGH);
  relayBoard.digitalWrite(P2, HIGH);
  relayBoard.digitalWrite(P3, HIGH);
  relayBoard.digitalWrite(P4, HIGH);
  relayBoard.digitalWrite(P5, HIGH);
  relayBoard.digitalWrite(P6, HIGH);
  relayBoard.digitalWrite(P7, HIGH);
}

void pulseOnlyOneRelay(int piste) {
  allRelaysOff();
  delay(RELAY_PRE_PULSE_MS);

  switch (piste) {
    case 1:
      Serial.println("Pulse RELAY1");
      relayOn(RELAY1);
      delay(RELAY_PULSE_ON_MS);
      relayOff(RELAY1);
      break;

    case 2:
      Serial.println("Pulse RELAY2");
      relayOn(RELAY2);
      delay(RELAY_PULSE_ON_MS);
      relayOff(RELAY2);
      break;

    case 3:
      Serial.println("Pulse RELAY3");
      relayOn(RELAY3);
      delay(RELAY_PULSE_ON_MS);
      relayOff(RELAY3);
      break;

    case 4:
      Serial.println("Pulse RELAY4");
      relayOn(RELAY4);
      delay(RELAY_PULSE_ON_MS);
      relayOff(RELAY4);
      break;

    default:
      Serial.println("Invalid piste");
      break;
  }

  delay(RELAY_POST_PULSE_MS);
  allRelaysOff();
}

// =====================================================
// Safe restart
// =====================================================
void restartBoard(const char* reason) {
  Serial.print("Restarting board: ");
  Serial.println(reason);
  allRelaysOff();
  delay(200);
  ESP.restart();
}

// =====================================================
// Ethernet events
// =====================================================
void onEthEvent(WiFiEvent_t event) {
  switch (event) {
    case ARDUINO_EVENT_ETH_START:
      Serial.println("ETH Started");
      ETH.setHostname("kc868-a8v2-stripe");
      break;

    case ARDUINO_EVENT_ETH_CONNECTED:
      Serial.println("ETH Connected");
      break;

    case ARDUINO_EVENT_ETH_GOT_IP:
      Serial.print("ETH IP: ");
      Serial.println(ETH.localIP());
      eth_connected = true;
      ethDownSinceMillis = 0;
      break;

    case ARDUINO_EVENT_ETH_DISCONNECTED:
      Serial.println("ETH Disconnected");
      eth_connected = false;
      if (ethDownSinceMillis == 0) ethDownSinceMillis = millis();
      break;

    case ARDUINO_EVENT_ETH_STOP:
      Serial.println("ETH Stopped");
      eth_connected = false;
      if (ethDownSinceMillis == 0) ethDownSinceMillis = millis();
      break;

    default:
      break;
  }
}

// =====================================================
// Ethernet start helper
// =====================================================
void startEthernet() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ETH.begin(ETH_PHY_TYPE, ETH_PHY_ADDR, ETH_PHY_MDC, ETH_PHY_MDIO, ETH_PHY_POWER, ETH_CLK_MODE);
#else
  ETH.begin(ETH_PHY_ADDR, ETH_PHY_POWER, ETH_PHY_MDC, ETH_PHY_MDIO, ETH_PHY_TYPE, ETH_CLK_MODE);
#endif

  if (USE_STATIC_ETH_IP) {
    bool cfgOk = ETH.config(ETH_LOCAL_IP, ETH_GATEWAY, ETH_SUBNET, ETH_DNS1, ETH_DNS2);
    Serial.println(cfgOk ? "ETH static IP configured" : "ETH static IP configuration failed");
  } else {
    Serial.println("ETH uses DHCP");
  }
}

// =====================================================
// Ethernet watchdog
// =====================================================
void checkEthernetWatchdog() {
  if (millis() - lastEthWatchdogMillis < ETH_WATCHDOG_MS) return;
  lastEthWatchdogMillis = millis();

  bool linkUp = ETH.linkUp();
  IPAddress ip = ETH.localIP();
  bool hasIp = (ip[0] != 0 || ip[1] != 0 || ip[2] != 0 || ip[3] != 0);

  if (linkUp && hasIp) {
    eth_connected = true;
    ethDownSinceMillis = 0;
    return;
  }

  eth_connected = false;
  if (ethDownSinceMillis == 0) ethDownSinceMillis = millis();

  unsigned long downDuration = millis() - ethDownSinceMillis;

  if (linkUp && !hasIp && downDuration >= ETH_NO_IP_RESTART_MS) {
    restartBoard("ETH link up but no IP too long");
  }

  if (!linkUp && downDuration >= ETH_LINK_DOWN_RESTART_MS) {
    restartBoard("ETH link down too long");
  }
}

// =====================================================
// HTTP handlers
// =====================================================
void handlePing() {
  lastRequestMillis = millis();
  server.send(200, "text/plain", "OK");
}

void handleHealth() {
  lastRequestMillis = millis();

  String msg = "{";
  msg += "\"ok\":true,";
  msg += "\"eth_connected\":" + String(eth_connected ? "true" : "false") + ",";
  msg += "\"ip\":\"" + (eth_connected ? ETH.localIP().toString() : String("0.0.0.0")) + "\",";
  msg += "\"uptime_ms\":" + String(millis() - bootMillis) + ",";
  msg += "\"last_request_ms_ago\":" + String(lastRequestMillis == 0 ? -1 : (long)(millis() - lastRequestMillis)) + ",";
  msg += "\"free_heap\":" + String(ESP.getFreeHeap());
  msg += "}";

  server.send(200, "application/json", msg);
}

void handleBody() {
  lastRequestMillis = millis();

  if (!server.hasArg("plain")) {
    server.send(200, "text/plain", "Requette recue sans donnees");
    return;
  }

  String body = server.arg("plain");

  Serial.println("BODY RECEIVED:");
  Serial.println(body);

  DeserializationError err = deserializeJson(jsonDocument, body);
  if (err) {
    Serial.print("JSON error: ");
    Serial.println(err.c_str());
    server.send(400, "text/plain", "JSON decode error");
    return;
  }

  String prixUneSession = jsonDocument["data"]["object"]["metadata"]["PrixUneSession"] | "";
  String prixDeuxSessions = jsonDocument["data"]["object"]["metadata"]["PrixDeuxSessions"] | "";
  String pisteStr = jsonDocument["data"]["object"]["metadata"]["Piste"] | "";
  String credit = jsonDocument["data"]["object"]["amount_total"] | "";
  String transactionID = jsonDocument["id"] | "";

  int piste = pisteStr.toInt();
  int creditValue = credit.toInt();
  int prixUneSessionValue = prixUneSession.toInt();
  int prixDeuxSessionsValue = prixDeuxSessions.toInt();
  int sessions = 0;

  if (prixDeuxSessionsValue > 0 && creditValue >= prixDeuxSessionsValue) {
    sessions = 2;
  } else if (prixUneSessionValue > 0 && creditValue >= prixUneSessionValue) {
    sessions = 1;
  } else {
    sessions = 1;
  }

  pendingPiste = piste;
  pendingSessions = sessions;
  pulsePending = true;

  Serial.println("PISTE : " + String(piste));
  Serial.println("CREDIT : " + credit);
  Serial.println("PRIX UNE SESSION : " + prixUneSession);
  Serial.println("PRIX DEUX SESSIONS : " + prixDeuxSessions);
  Serial.println("NOMBRE DE SESSIONS : " + String(sessions));

  server.send(200, "text/plain",
              "Succes : =>" + transactionID + "<= Piste " + pisteStr +
              " activee pour " + credit + " euros et " +
              String(sessions) + " sessions");
}

// =====================================================
// Setup
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("Booting KC868-A8v2 Stripe Activation Board...");

  bootMillis = millis();
  lastHealthLogMillis = millis();

  // Configure all PCF8574 pins as outputs
  relayBoard.pinMode(P0, OUTPUT);
  relayBoard.pinMode(P1, OUTPUT);
  relayBoard.pinMode(P2, OUTPUT);
  relayBoard.pinMode(P3, OUTPUT);
  relayBoard.pinMode(P4, OUTPUT);
  relayBoard.pinMode(P5, OUTPUT);
  relayBoard.pinMode(P6, OUTPUT);
  relayBoard.pinMode(P7, OUTPUT);

  if (!relayBoard.begin()) {
    Serial.println("PCF8574 relay board not found!");
  } else {
    Serial.println("PCF8574 relay board found.");
  }

  // Safe startup: relays OFF only, no test pulse
  allRelaysOff();
  delay(200);
  allRelaysOff();

  WiFi.onEvent(onEthEvent);
  startEthernet();

  unsigned long ethWaitStart = millis();
  while (!eth_connected && (millis() - ethWaitStart < BOOT_ETH_WAIT_MS)) {
    delay(500);
    Serial.println("Waiting for Ethernet...");
  }

  if (eth_connected) {
    Serial.print("Board IP address: ");
    Serial.println(ETH.localIP());
  } else {
    Serial.println("Ethernet not ready at boot, continuing anyway...");
    ethDownSinceMillis = millis();
  }

  server.on("/body", HTTP_ANY, handleBody);
  server.on("/ping", HTTP_GET, handlePing);
  server.on("/health", HTTP_GET, handleHealth);
  server.begin();

  Serial.println("HTTP server started");
}

// =====================================================
// Main loop
// =====================================================
void loop() {
  server.handleClient();
  checkEthernetWatchdog();

  if (millis() - lastHealthLogMillis >= HEALTH_LOG_MS) {
    Serial.println("===== HEALTH =====");
    Serial.print("ETH connected: ");
    Serial.println(eth_connected ? "YES" : "NO");

    if (eth_connected) {
      Serial.print("IP: ");
      Serial.println(ETH.localIP());
    } else {
      if (ethDownSinceMillis == 0) ethDownSinceMillis = millis();
      Serial.print("ETH down for ms: ");
      Serial.println(millis() - ethDownSinceMillis);
    }

    Serial.print("Free heap: ");
    Serial.println(ESP.getFreeHeap());

    Serial.print("Last request ms ago: ");
    Serial.println(lastRequestMillis == 0 ? -1 : (long)(millis() - lastRequestMillis));

    lastHealthLogMillis = millis();
  }

  if (ENABLE_DAILY_REBOOT && (millis() - bootMillis >= DAILY_REBOOT_MS)) {
    restartBoard("Daily preventive reboot");
  }

  if (pulsePending) {
    pulsePending = false;

    for (int i = 0; i < pendingSessions; i++) {
      pulseOnlyOneRelay(pendingPiste);

      if (i < (pendingSessions - 1)) {
        delay(RELAY_INTER_PULSE_GAP_MS);
      }
    }

    pendingPiste = 0;
    pendingSessions = 0;
    allRelaysOff();
  }
}
