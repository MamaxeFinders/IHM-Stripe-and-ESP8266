#include <Arduino.h>
#include <esp_arduino_version.h>

// ===== Ethernet PHY config =====
#define ETH_PHY_TYPE   ETH_PHY_LAN8720
#define ETH_PHY_ADDR   0
#define ETH_PHY_MDC    23
#define ETH_PHY_MDIO   18
#define ETH_PHY_POWER  -1
#define ETH_CLK_MODE   ETH_CLOCK_GPIO17_OUT

#include <WiFi.h>
#include <ETH.h>
#include <WebServer.h>
#include <ArduinoJson.h>
#include <PCF8574.h>

#define ARDUINOJSON_DEFAULT_NESTING_LIMIT 20

// ===== KC868-A8v2 I2C / Relay board =====
// KinCony examples use PCF8574(0x24,4,5)
PCF8574 relayBoard(0x24, 4, 5);

WebServer server(80);
StaticJsonDocument<2500> jsonDocument;

// ===== Relay mapping =====
#define RELAY1 P0
#define RELAY2 P1
#define RELAY3 P2
#define RELAY4 P3

volatile bool eth_connected = false;

// One request = one pulse job
int pendingPiste = 0;
int pendingSessions = 0;
bool pulsePending = false;

// Coin pulse timing (fast but reliable for external pulse inputs)
const uint16_t RELAY_PRE_PULSE_MS = 20;
const uint16_t RELAY_PULSE_ON_MS = 140;
const uint16_t RELAY_POST_PULSE_MS = 80;
const uint16_t RELAY_INTER_PULSE_GAP_MS = 180;

PCF8574::DigitalInput relayState = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};

// =====================================================
// Relay logic
// KinCony relays are active LOW:
// LOW  = ON
// HIGH = OFF
// =====================================================
bool applyRelayState() {
  return relayBoard.digitalWriteAll(relayState);
}

void setOnlyRelayActive(int piste) {
  relayState.p0 = HIGH;
  relayState.p1 = HIGH;
  relayState.p2 = HIGH;
  relayState.p3 = HIGH;
  relayState.p4 = HIGH;
  relayState.p5 = HIGH;
  relayState.p6 = HIGH;
  relayState.p7 = HIGH;

  switch (piste) {
    case 1:
      relayState.p0 = LOW;
      break;
    case 2:
      relayState.p1 = LOW;
      break;
    case 3:
      relayState.p2 = LOW;
      break;
    case 4:
      relayState.p3 = LOW;
      break;
    default:
      break;
  }

  applyRelayState();
}

void allRelaysOff() {
  relayState.p0 = HIGH;
  relayState.p1 = HIGH;
  relayState.p2 = HIGH;
  relayState.p3 = HIGH;
  relayState.p4 = HIGH;
  relayState.p5 = HIGH;
  relayState.p6 = HIGH;
  relayState.p7 = HIGH;
  applyRelayState();
}

void pulseOnlyOneRelay(int piste) {
  allRelaysOff();
  delay(RELAY_PRE_PULSE_MS);

  switch (piste) {
    case 1:
      Serial.println("Pulse RELAY1");
      setOnlyRelayActive(1);
      delay(RELAY_PULSE_ON_MS);
      allRelaysOff();
      break;

    case 2:
      Serial.println("Pulse RELAY2");
      setOnlyRelayActive(2);
      delay(RELAY_PULSE_ON_MS);
      allRelaysOff();
      break;

    case 3:
      Serial.println("Pulse RELAY3");
      setOnlyRelayActive(3);
      delay(RELAY_PULSE_ON_MS);
      allRelaysOff();
      break;

    case 4:
      Serial.println("Pulse RELAY4");
      setOnlyRelayActive(4);
      delay(RELAY_PULSE_ON_MS);
      allRelaysOff();
      break;

    default:
      Serial.println("Invalid piste");
      break;
  }

  delay(RELAY_POST_PULSE_MS);
  allRelaysOff();
}

// =====================================================
// Ethernet events
// =====================================================
void onEthEvent(WiFiEvent_t event) {
  switch (event) {
    case ARDUINO_EVENT_ETH_START:
      Serial.println("ETH Started");
      ETH.setHostname("kc868-a8v2-stripe");
      break;

    case ARDUINO_EVENT_ETH_CONNECTED:
      Serial.println("ETH Connected");
      break;

    case ARDUINO_EVENT_ETH_GOT_IP:
      Serial.print("ETH IP: ");
      Serial.println(ETH.localIP());
      eth_connected = true;
      break;

    case ARDUINO_EVENT_ETH_DISCONNECTED:
      Serial.println("ETH Disconnected");
      eth_connected = false;
      break;

    case ARDUINO_EVENT_ETH_STOP:
      Serial.println("ETH Stopped");
      eth_connected = false;
      break;

    default:
      break;
  }
}

// =====================================================
// HTTP handlers
// =====================================================
void handlePing() {
  server.send(200, "text/plain", "OK");
}

void handleBody() {
  if (!server.hasArg("plain")) {
    server.send(200, "text/plain", "Requette recue sans donnees");
    return;
  }

  String body = server.arg("plain");

  Serial.println("BODY RECEIVED:");
  Serial.println(body);

  DeserializationError err = deserializeJson(jsonDocument, body);
  if (err) {
    Serial.print("JSON error: ");
    Serial.println(err.c_str());
    server.send(400, "text/plain", "JSON decode error");
    return;
  }

  String prixUneSession = jsonDocument["data"]["object"]["metadata"]["PrixUneSession"] | "";
  String prixDeuxSessions = jsonDocument["data"]["object"]["metadata"]["PrixDeuxSessions"] | "";
  String pisteStr = jsonDocument["data"]["object"]["metadata"]["Piste"] | "";
  String credit = jsonDocument["data"]["object"]["amount_total"] | "";
  String transactionID = jsonDocument["id"] | "";

  int piste = pisteStr.toInt();
  int creditValue = credit.toInt();
  int prixUneSessionValue = prixUneSession.toInt();
  int prixDeuxSessionsValue = prixDeuxSessions.toInt();
  int sessions = 0;

  if (prixDeuxSessionsValue > 0 && creditValue >= prixDeuxSessionsValue) {
    sessions = 2;
  } else if (prixUneSessionValue > 0 && creditValue >= prixUneSessionValue) {
    sessions = 1;
  } else {
    sessions = 1; // fallback
  }

  pendingPiste = piste;
  pendingSessions = sessions;
  pulsePending = true;

  Serial.println("PISTE : " + String(piste));
  Serial.println("CREDIT : " + credit);
  Serial.println("PRIX UNE SESSION : " + prixUneSession);
  Serial.println("PRIX DEUX SESSIONS : " + prixDeuxSessions);
  Serial.println("NOMBRE DE SESSIONS : " + String(sessions));

  server.send(200, "text/plain",
              "Succes : =>" + transactionID + "<= Piste " + pisteStr +
              " activee pour " + credit + " euros et " +
              String(sessions) + " sessions");
}

// =====================================================
// Setup
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("Booting KC868-A8v2 Stripe Activation Board...");

  // Configure ALL PCF8574 pins as outputs
  relayBoard.pinMode(P0, OUTPUT);
  relayBoard.pinMode(P1, OUTPUT);
  relayBoard.pinMode(P2, OUTPUT);
  relayBoard.pinMode(P3, OUTPUT);
  relayBoard.pinMode(P4, OUTPUT);
  relayBoard.pinMode(P5, OUTPUT);
  relayBoard.pinMode(P6, OUTPUT);
  relayBoard.pinMode(P7, OUTPUT);

  if (!relayBoard.begin()) {
    Serial.println("PCF8574 relay board not found!");
  } else {
    Serial.println("PCF8574 relay board found.");
  }

  // Default state = ALL RELAYS OFF
  allRelaysOff();
  delay(200);
  allRelaysOff();

  WiFi.onEvent(onEthEvent);

#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ETH.begin(ETH_PHY_TYPE, ETH_PHY_ADDR, ETH_PHY_MDC, ETH_PHY_MDIO, ETH_PHY_POWER, ETH_CLK_MODE);
#else
  ETH.begin(ETH_PHY_ADDR, ETH_PHY_POWER, ETH_PHY_MDC, ETH_PHY_MDIO, ETH_PHY_TYPE, ETH_CLK_MODE);
#endif

  while (!eth_connected) {
    delay(500);
    Serial.println("Waiting for Ethernet...");
  }

  Serial.print("Board IP address: ");
  Serial.println(ETH.localIP());

  server.on("/body", HTTP_ANY, handleBody);
  server.on("/ping", HTTP_GET, handlePing);
  server.begin();

  Serial.println("HTTP server started");
}

// =====================================================
// Main loop
// =====================================================
void loop() {
  server.handleClient();

  if (pulsePending) {
    pulsePending = false;

    // Original logic: if 1 session => one pulse, if 2 sessions => two pulses
    for (int i = 0; i < pendingSessions; i++) {
      pulseOnlyOneRelay(pendingPiste);

      if (i < (pendingSessions - 1)) {
        delay(RELAY_INTER_PULSE_GAP_MS);
      }
    }

    pendingPiste = 0;
    pendingSessions = 0;
    allRelaysOff();
  }
}
